# Copy this file to .env.local and fill in your Apps Script Web App URL.
# See google-apps-script/README.md for deployment steps.
VITE_SHEETS_WEB_APP_URL=

# Supabase project (Project Settings -> API in the Supabase dashboard)
# Use the "publishable" key — never the secret/service_role key — in frontend code.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
